{
  "name": "nombreapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run iconos && npm run validar-datos && node scripts/preparar-datos.mjs && tsc -b && vite build && npm run verificar-peso",
    "preview": "vite preview --host --port 4173",
    "iconos": "node scripts/generar-iconos.mjs",
    "verificar-peso": "node scripts/verificar-peso.mjs",
    "tipos": "tsc -b --noEmit false --emitDeclarationOnly false",
    "predev": "npm run datos",
    "datos": "node scripts/validar-catalogo.mjs --escribir && node scripts/preparar-datos.mjs",
    "validar-datos": "node scripts/validar-catalogo.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}